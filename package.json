{
  "name": "scaffold",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "deploy": "pnpm run build && wrangler deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint",
    "typecheck": "tsc -b",
    "assets": "python scripts/assets.py",
    "db:migrate": "wrangler d1 migrations apply spendly-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply spendly-db --remote"
  },
  "dependencies": {
    "@clerk/backend": "^3.27.0",
    "@clerk/localizations": "^4.24.8",
    "@clerk/react": "^6.18.6",
    "@sentry/cloudflare": "^11.12.0",
    "@sentry/react": "^11.12.0",
    "@tanstack/query-sync-storage-persister": "^5.107.1",
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-query-persist-client": "^5.107.1",
    "hono": "^4.13.18",
    "idb": "^8.0.4",
    "motion": "^14.12.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.69.0",
    "@cloudflare/workers-types": "^5.20261110.1",
    "@sentry/vite-plugin": "^11.12.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.90.0",
    "tailwindcss": "^4.3.5",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0",
    "workbox-window": "^7.4.1",
    "wrangler": "^4.160.1"
  }
}
